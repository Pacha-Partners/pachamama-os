# ---- Base de donnees -------------------------------------------------------
# ⚠️ PORT 6543 = pooler en mode transaction. Obligatoire pour une API
# concurrente. Le port 5432 (connexion directe) evite le piege des prepared
# statements mais plafonne en nombre de connexions.
# A recuperer dans Supabase → Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.<ref>:<motdepasse>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Schema de la base talent
DB_SCHEMA=pivot

# ---- Verification des jetons ----------------------------------------------
# Secret de signature du fournisseur d'identite, pour VERIFIER les jetons.
# A recuperer dans Supabase → Settings → API → JWT Settings → JWT Secret
JWT_SECRET=
JWT_AUDIENCE=authenticated

# ---- Divers ---------------------------------------------------------------
ENVIRONNEMENT=developpement
ORIGINES_AUTORISEES=["http://localhost:3000"]
