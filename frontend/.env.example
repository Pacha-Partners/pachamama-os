# ---- Supabase (cote navigateur : ces valeurs sont publiques par nature) ----
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- API d'acces (FastAPI) -------------------------------------------------
API_URL=http://127.0.0.1:8000

# ⚠️ La cle de service (SERVICE_ROLE) n'a RIEN a faire ici : elle contourne la
# Row Level Security. Elle ne vit que cote API et cote scripts de donnees.

# --- Comptes de test des harnais de recette -----------------------------
# Les harnais j2/j3 refusent de tourner sans ces variables. Elles ne portent
# JAMAIS de valeur par défaut dans le code : ce sont des adresses de personnes
# réelles et le dépôt est public. Voir COMPTES_DE_TEST.md, hors git.
TEST_MDP=
TEST_ENTREPRISE_EMAIL=
TEST_TALENT_EMAIL=
TEST_RECRUTEUR_EMAIL=
