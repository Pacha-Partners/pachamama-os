# ---- Base talent unifiée (Supabase PostgreSQL) ----
# L'URL du projet et la clé de service. La clé de service NE DOIT JAMAIS
# être exposée au navigateur : elle n'est lue que dans des composants serveur.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Accès applicatif (comptes de démonstration pour le jury) ----
AUTH_SECRET=change-moi-par-une-chaine-aleatoire-de-32-caracteres
DEMO_RECRUTEUR_USER=recruteur
DEMO_RECRUTEUR_PASS=change-moi
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASS=change-moi

# --- Sources externes, pour les connecteurs d'ingestion ------------------
# Optionnelles : l'API demarre sans elles. Seuls les connecteurs les exigent.

# Jarvi, API REST v2. Il faut la cle PRIVEE : la documentation dit
# « The public key may only create profiles and applications; every other
# route needs the private key. » Transmise dans l'en-tete X-API-KEY.
# La cle privee n'est plus affichee apres sa generation : la noter ici.
JARVI_API_KEY=
JARVI_API_BASE=https://functions.prod.jarvi.tech/v1/public-api/rest/v2

# Cle service_role Supabase — pour les CONNECTEURS uniquement, jamais pour
# l'API ni le frontend. Elle contourne la securite au niveau ligne.
SUPABASE_SERVICE_ROLE_KEY=
